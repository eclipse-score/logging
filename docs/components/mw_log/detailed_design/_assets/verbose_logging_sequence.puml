@startuml verbose_logging_sequence

title Verbose log call with the DataRouterRecorder

participant "App" as App
participant "Runtime" as Runtime
participant "LogStream" as LogStream
participant "DataRouterRecorder" as DataRouterRecorder
participant "DataRouterBackend" as DataRouterBackend
participant "DLTFormat" as DLTFormat
participant "TRACE" as TRACE
participant "SharedMemoryWriter" as SharedMemoryWriter

Runtime -> DataRouterRecorder : creates (RemoteDltRecorderFactory)

App -> LogStream : construct (via log function)

LogStream -> DataRouterRecorder : StartRecord(context_id, log_level)
activate DataRouterRecorder
DataRouterRecorder -> DataRouterRecorder : statistics update,\nIsLogEnabled(log_level, context_id)

alt log level not enabled
    LogStream <-- DataRouterRecorder : empty optional<SlotHandle>
else log level enabled
    DataRouterRecorder -> DataRouterBackend : ReserveSlot()
    DataRouterRecorder <-- DataRouterBackend : optional<SlotHandle>
    alt slot available
        DataRouterRecorder -> DataRouterBackend : GetLogRecord(slot)
        DataRouterRecorder -> DataRouterRecorder : clean record, set application id,\ncontext id and log level
    else no slot available
        DataRouterRecorder -> DataRouterRecorder : IncrementNoSlotAvailable()
    end
    LogStream <-- DataRouterRecorder : optional<SlotHandle>
end
deactivate DataRouterRecorder

App -> LogStream : << data

LogStream -> DataRouterRecorder : Log(slot, data)
activate DataRouterRecorder
DataRouterRecorder -> DataRouterBackend : GetLogRecord(slot)
DataRouterRecorder -> DLTFormat : Log(VerbosePayload, data)
note right of DLTFormat : The argument is added to the\nLogRecord. If it does not fit,\nIncrementMessageTooLong() is called.
LogStream <-- DataRouterRecorder
deactivate DataRouterRecorder

App -> LogStream : destruct

LogStream -> DataRouterRecorder : StopRecord(slot)
activate DataRouterRecorder
DataRouterRecorder -> DataRouterBackend : FlushSlot(slot)
activate DataRouterBackend
DataRouterBackend -> TRACE : Trace<Level>(LogEntry)
TRACE -> SharedMemoryWriter : AllocAndWrite(...)
DataRouterBackend -> DataRouterBackend : ReleaseSlot
deactivate DataRouterBackend
LogStream <-- DataRouterRecorder
deactivate DataRouterRecorder

@enduml
