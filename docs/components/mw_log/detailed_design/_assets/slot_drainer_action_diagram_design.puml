@startuml slot_drainer_action_diagram_design

skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor black
skinparam ArrowColor black
skinparam PartitionBackgroundColor orange
skinparam PartitionBorderColor black

title Slot disposal diagram

start

:FlushSlot call
circular_buffer.push_back(SlotHandle);

partition SlotDrainer #orange {
  repeat
    partition NonBlockingWriter #3c7a00 {
      repeat
        :write the current span (FlushIntoFile);
        if (result?) then ([would block or error])
          #orange:exit, the data stays pending;
          detach
        else ([span written])
        endif
        :get the next span from the message builder;
      repeat while (next span available?) is (yes) not (no)
    }

    :release the slot to the allocator;
    if (slots flushed in this call above the limit?) then ([limit exceeded])
      #orange:exit;
      detach
    else ([within limit])
    endif
    :take the next slot from the circular buffer\nand set it as next message;
  repeat while (circular buffer not empty?) is (yes) not (no)
}

stop

@enduml
