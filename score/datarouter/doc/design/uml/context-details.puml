@startuml context-details

skinparam componentBackgroundColor<<safety critical>> Aquamarine
skinparam componentBackgroundColor<<needs review>> DarkCyan
skinparam componentFontColor<<needs review>> White
skinparam queueBackgroundColor<<safety critical>> Aquamarine

frame "Adaptive Application" as adaptive_application_context {
  node AdaptiveApplication {
    component ApplicationLogic
    interface "mw::log" as aralog1
    component "mw::log implementation" as aralog1_impl <<safety critical>>

    aralog1 - aralog1_impl
    ApplicationLogic --> aralog1 : verbose
    ApplicationLogic --> aralog1 : non-verbose
  }

  queue SharedMemoryBuffer1 as SMB1 <<safety critical>>
  database "logging.json" as cfg1
  note right of cfg1 : Discovered in order:\n1. /etc/ecu_logging_config.json (global)\n2. $MW_LOG_CONFIG_FILE (env override)\n3. <binary>/../etc/logging.json\n4. etc/logging.json (cwd)\n5. logging.json (cwd)
  aralog1_impl ..> cfg1 : read config
}

frame "System Application" as system_application_context {
  node SystemApplication {
    component SystemApplicationLogic
    interface "mw::log" as aralog2
    component "mw::log implementation" as aralog2_impl <<safety critical>>

    aralog2 - aralog2_impl
    SystemApplicationLogic --> aralog2 : verbose
    SystemApplicationLogic --> aralog2 : non-verbose
  }

  queue SharedMemoryBuffer2 as SMB2 <<safety critical>>
  database "logging.json" as cfg2
  aralog2_impl ..> cfg2 : read config
}

note right of SMB1 : Shared memory\nallocated by AdaptiveApplication

aralog1_impl ..> SMB1 : own
aralog2_impl ..> SMB2 : own
aralog1_impl --> SMB1 : write
aralog2_impl --> SMB2 : write

node "Datarouter" {

  component [Source Session 1] as sourcesession1 <<needs review>>
  component [Source Session 2] as sourcesession2 <<needs review>>

  component "DltNonverboseHandler" as nvh
  component "DltVerboseHandler" as vh
  component "FileTransferStreamHandler" as fthandler

  SMB1 <-- sourcesession1 : read via ISharedMemoryReader
  SMB2 <-- sourcesession2 : read via ISharedMemoryReader

  component "DltLogServer" as dlt_out {
    component "FilterAndCall\n(Channel Assignment\n& Threshold Filter)" as Demux
    component "DltLogChannel 1\n(UDP, per log-channels.json)" as dlt_ch1
    component "DltLogChannel 2\n(UDP, per log-channels.json)" as dlt_ch2
    component "... DltLogChannel N" as dlt_chN
    Demux -> dlt_ch1
    Demux -> dlt_ch2
    Demux -> dlt_chN
  }

  database "log-channels.json" as channels_cfg
  channels_cfg ..> Demux : configure channels\n& assignments

  database "class-id.json\n(NvMsgDescriptors)" as type_id
  type_id ..> sourcesession1
  type_id ..> sourcesession2
}

frame "DLT Channels (UDP multicast)" {
  boundary "DltLogChannel 1" as udp_1
  boundary "DltLogChannel 2" as udp_2
  boundary "DltLogChannel N" as udp_N
}

sourcesession1 --> nvh : * (global handler,\nall messages)
sourcesession2 --> nvh : * (global handler,\nall messages)
sourcesession1 --> vh : <LogEntry>
sourcesession2 --> vh : <LogEntry>
sourcesession1 --> fthandler : <FileTransferEntry>
sourcesession2 --> fthandler : <FileTransferEntry>

vh -> dlt_out : SendVerbose
nvh -> dlt_out : SendNonVerbose
fthandler -> dlt_out : SendFtVerbose

dlt_ch1 -> udp_1
dlt_ch2 -> udp_2
dlt_chN -> udp_N

@enduml
