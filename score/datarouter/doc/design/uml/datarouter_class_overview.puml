@startuml datarouter_class_overview
title Datarouter Class Overview

class SocketServer
class DltLogServer
class DataRouter
class SourceSession
interface ILogParserFactory
interface ILogParser
class DltNonverboseHandler
class DltVerboseHandler
class FileTransferStreamHandler

SocketServer --> DltLogServer : creates
SocketServer --> DataRouter : creates
SocketServer --> ILogParserFactory : creates

DataRouter *-- ILogParserFactory : owns
DataRouter *-- "0..*" SourceSession : owns
SourceSession *-- ILogParser : owns

DltLogServer *-- DltNonverboseHandler : owns
DltLogServer *-- DltVerboseHandler : owns
DltLogServer *-- FileTransferStreamHandler : owns

ILogParserFactory --> DltLogServer : concrete implementation queries handlers via\nGetGlobalHandlers() and\nGetTypeHandlerBindings()

ILogParserFactory ..> ILogParser : creates

@enduml
