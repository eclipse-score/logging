' Unit diagram required by the architectural_design validation: every participant
' of a sequence diagram is a unit here, and every connected pair of units calls
' each other in a sequence diagram. The interface names (caller and callee) follow
' the convention of the validator and are not code interfaces.

@startuml component_diagram

skinparam componentStyle rectangle
left to right direction

title Units and unit bindings of the sequence diagrams of the datarouter

package "ClientSessionAndDatarouter" as pkg_session {
    component "UserThreads_ClientA" as UTA <<unit>>
    component "SharedMemoryWriter_ClientA" as SHMA <<unit>>
    component "QnxDispatchEngine_ClientA" as AE <<unit>>
    component "QnxDispatchEngine_ClientX" as XE <<unit>>
    component "ServerEngine" as SE <<unit>>
    component "MpWorkerThread" as MW <<unit>>
    component "WatchdogTimer" as WD <<unit>>
    component "DltOutput" as DLT <<unit>>
    component "Client" as MC <<unit>>
    component "OnConnectRequest" as OC <<unit>>
    component "DisconnectCallback" as DC <<unit>>
}

package "ConfigurationSession" as pkg_config {
    component "DataRouterConfiguratorApp" as DRConf <<unit>>
    component "DiagnosticManager" as DiagM <<unit>>
    component "DataRouterConfiguratorService" as DRConfService <<unit>>
    component "UnixDomainClient" as UDC <<unit>>
    component "UnixDomainServer" as UDS <<unit>>
    component "UnixDomainSocket" as Socket <<unit>>
    component "ConfigSession" as ConfigSession <<unit>>
    component "DltLogServer" as DLTS <<unit>>
    component "PersistentDictionary" as PD <<unit>>
}

package "InitializationAndMessageProcessing" as pkg_init_proc {
    component "SocketServer" as SS <<unit>>
    component "DltLogServer" as DLS <<unit>>
    component "ILogParserFactory" as ILPF <<unit>>
    component "DataRouter" as DR <<unit>>
    component "SourceSession" as SRC <<unit>>
    component "LogParser" as LP <<unit>>
    component "DltVerboseHandler" as VH <<unit>>
    component "DltNonverboseHandler" as NH <<unit>>
    component "FileTransferStreamHandler" as FTH <<unit>>
    component "DltChannel" as CH <<unit>>
}

