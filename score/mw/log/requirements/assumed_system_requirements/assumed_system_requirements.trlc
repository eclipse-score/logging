package MwLogAssumedSystemRequirements

import ScoreReq

ScoreReq.AssumedSystemReq ASR_LoggingSupport {
    description = "The platform shall support Diagnostic Log and Trace (DLT) / Logcat format as well as logging of early startup events."
    safety = ScoreReq.Asil.QM
    rationale = "Applications and platform components need a common, well-known logging format and the ability to capture events from early boot, so that logs can be captured, forwarded and post-processed consistently across the platform."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_SafeLogAndTrace {
    description = '''The platform shall provide a Log and Trace infrastructure supporting the highest ASIL level, guaranteeing freedom from interference (FFI) with regard to the calling components.'''
    safety = ScoreReq.Asil.B
    rationale = "Safety-qualified applications must be able to use logging and tracing without their safety integrity being compromised."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_SecureLogAndTrace{
    description = "The information exchanged between applications and the Logging and Tracing components shall be protected against unauthorized access and manipulation. The platform shall provide mechanisms to ensure confidentiality, integrity, and authenticity of the exchanged information."
    safety = ScoreReq.Asil.QM
    rationale = "Not all applications running on the platform are trusted. Therefore, applications shall not be able to manipulate or access information exchanged between other applications."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_StablePublicApi {
    description = "The platform shall provide a stable API for the logging middleware."
    safety = ScoreReq.Asil.QM
    rationale = "A stable API helps to ensure that applications can be developed and maintained over time without being affected by changes in the underlying platform."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_ErrorHandling {
    description = """(C++) exceptions shall not be used for error handling.
The best way to deal with errors is to try to resolve those component internally. If not possible the caller of the function shall be notified of the error.
For (error) returns there is a specific library to be used in S-CORE, it is the score::Result library which is part of
the Base Libraries feature."""
    safety = ScoreReq.Asil.B
    rationale = "Exceptions will be directly leading to an abort and thus reducing availability of the S-CORE platform."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_LogAndTraceConsistentBehaviour {
    description = "All Log and Trace functionality used in the context of customer functionality shall provide consistent behaviour."
    safety = ScoreReq.Asil.QM
    rationale = "Log and Trace functionality must minimize its interference on the timing and performance of the customer functionality."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_ProgrammingLanguagesForApplicationDevelopment {
    description = "The platform shall support implementation of applications in the following programming languages up to the highest ASIL level as defined in automotive_safety: C++, Rust."
    safety = ScoreReq.Asil.B
    rationale = "There are several programming languages available for safety related application development. The platform shall support communication between applications implemented in these languages."
    version = 1
}

ScoreReq.AssumedSystemReq ASR_OverallGoalsEnableCooperation {
    description = '''The SW-platform shall where possible be based on existing standards (e.g. network
    protocols).'''
    safety = ScoreReq.Asil.QM
    rationale = "To enable cooperation with other cooperation partners."
    version = 1
}
