@startuml shared_memory_reader_read

title SharedMemoryReader::NotifyAcquisitionSetReader and SharedMemoryReader::Read

participant "Datarouter" as Datarouter
participant "SharedMemoryReader" as SharedMemoryReader
participant "AlternatingReadOnlyReader" as AlternatingReadOnlyReader
participant "LinearReader" as LinearReader
participant "TypeRegistrationCallback" as TypeRegistrationCallback
participant "NewRecordCallback" as NewRecordCallback

== Acquire (after the response of the client) ==

Datarouter -> SharedMemoryReader : NotifyAcquisitionSetReader(ReadAcquireResult)
SharedMemoryReader -> AlternatingReadOnlyReader : IsBlockReleasedByWriters(acquired_buffer)
alt block not released by the writers
    Datarouter <-- SharedMemoryReader : empty optional (error is printed)
else block released
    SharedMemoryReader -> AlternatingReadOnlyReader : CreateLinearReader(acquired_buffer)
    SharedMemoryReader -> SharedMemoryReader : keep the reader,\nnext buffer = acquired_buffer + 1
    Datarouter <-- SharedMemoryReader : number of acquired bytes
end

== Read ==

Datarouter -> SharedMemoryReader : Read(TypeRegistrationCallback, NewRecordCallback)
alt finished reading after detach
    Datarouter <-- SharedMemoryReader : empty optional
else
    opt acquired data available
        loop LinearReader::Read() returns data
            alt entry smaller than BufferEntryHeader
                SharedMemoryReader -> SharedMemoryReader : skip entry
            else header read
                SharedMemoryReader -> LinearReader : Read()
                alt type identifier is the register type token
                    SharedMemoryReader -> TypeRegistrationCallback : TypeRegistration
                else regular log record
                    SharedMemoryReader -> NewRecordCallback : SharedMemoryRecord
                end
            end
        end
    end
    opt writer detached
        SharedMemoryReader -> AlternatingReadOnlyReader : CreateLinearReader(next buffer)
        SharedMemoryReader -> SharedMemoryReader : read the remaining data like above,\nfinished reading after detach = true
    end
    Datarouter <-- SharedMemoryReader : number of read bytes
end

@enduml
