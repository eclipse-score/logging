@startuml shared_memory_reader_read

title SharedMemoryReader::Read / ReadAcquiredData / CreateReaderForBuffer / ReadLinearBuffer / ReadRemainingDataIfWriterIsDetached

participant "SharedMemoryReader" as SharedMemoryReader
participant "SharedData" as SharedData
participant "LinearReader" as LinearReader
participant "TypeRegistrationCallback" as TypeRegistrationCallback
participant "NewRecordCallback" as NewRecordCallback

alt finished reading after detach
else continue reading
    SharedMemoryReader -> SharedMemoryReader : ReadAcquiredData
    alt data acquired
        SharedMemoryReader -> SharedMemoryReader : CreateReaderForBuffer
        alt buffer1 not acquired
            SharedMemoryReader -> SharedData : Use control_block_1
        else buffer1 acquired
            SharedMemoryReader -> SharedData : Use control_block_2
        end
        SharedMemoryReader -> LinearReader : Create reader from selected buffer
        loop read successful
            alt register type token
                SharedMemoryReader -> TypeRegistrationCallback : Trigger type registration callback
            else regular log record
                SharedMemoryReader -> NewRecordCallback : Trigger new message callback
            end
        end
    end
    alt writer detached
        SharedMemoryReader -> SharedMemoryReader : CreateReaderForBuffer
        SharedMemoryReader -> LinearReader : Read remaining data
    end
end

@enduml
