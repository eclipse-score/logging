@startuml shared_memory_writer_allocandwrite

title SharedMemoryWriter::AllocAndWrite

participant "SharedMemoryWriter" as SharedMemoryWriter
participant "SharedData" as SharedData
participant "DropCounters" as DropCounters

alt payload size exceeds limit
    SharedMemoryWriter -> DropCounters : Increment invalid-size drops
else payload size accepted
    SharedMemoryWriter -> SharedData : Acquire data
    alt data acquired
        SharedMemoryWriter -> SharedData : Write header
        SharedMemoryWriter -> SharedData : Access memory
        SharedMemoryWriter -> SharedData : Write payload
        SharedMemoryWriter -> SharedData : Release acquired data
    else buffer full
        SharedMemoryWriter -> DropCounters : Increment buffer-full drops
    end
end

@enduml
