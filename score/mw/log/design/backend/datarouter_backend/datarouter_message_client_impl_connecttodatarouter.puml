@startuml DatarouterMessageClientImpl_ConnectToDatarouter
title DatarouterMessageClientImpl::ConnectToDatarouter

participant "Client" as Client
participant "SignalHandling" as SignalHandling
participant "Sender" as Sender
participant "Receiver" as Receiver
participant "SharedMemory" as SharedMemory
participant "Connection" as Connection
participant "ThreadPool" as ThreadPool

Client -> SignalHandling : Block termination signal
Client -> Sender : Create sender
Client -> Receiver : Start receiver

alt receiver started
    opt exit not requested
        Client -> Sender : Send connect message
    end
else receiver not started
    Client -> SharedMemory : Unlink shared memory file
    Client -> Connection : Request stop for connection
    Client -> ThreadPool : Shutdown thread pool
end

@enduml
