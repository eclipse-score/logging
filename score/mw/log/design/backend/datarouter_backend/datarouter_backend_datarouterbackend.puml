@startuml datarouter_backend_datarouterbackend

title DataRouterBackend::DataRouterBackend

participant "DataRouterBackend" as DataRouterBackend
participant "WriterFactory" as WriterFactory
participant "Logger" as Logger
participant "MessageClientFactory" as MessageClientFactory
participant "MessageClient" as MessageClient

DataRouterBackend -> WriterFactory : Create shared memory writer

alt writer has value
  DataRouterBackend -> Logger : Initialize Logger::Instance()
  DataRouterBackend -> MessageClientFactory : Create message client
  MessageClientFactory --> DataRouterBackend : Message client
  DataRouterBackend -> MessageClient : Run message client
else no writer
end

@enduml
