module(name = "score_logging")

# CodeQL Coding Standards release
CODEQL_STANDARDS_VERSION = "2.62.0"

# Bazel global rules
bazel_dep(name = "rules_python", version = "1.8.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_rust", version = "0.68.2-score")
git_override(
    module_name = "rules_rust",
    commit = "2098bd56fa9282f78ab56f6a3118c24db3425f8c",  # FIXME: switch to the next -score release (contains eclipse-score/rules_rust#23)
    remote = "https://github.com/eclipse-score/rules_rust.git",
)

bazel_dep(name = "rules_cc", version = "0.2.17")

bazel_dep(name = "aspect_rules_lint", version = "2.5.0", dev_dependency = True)
bazel_dep(name = "score_cpp_policies", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "score_cpp_policies",
    commit = "b6551c217fbb0daf948b493c4ba69eb7fe8359a5",
    remote = "https://github.com/eclipse-score/score_cpp_policies.git",
)

bazel_dep(name = "toolchains_llvm", version = "1.8.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)

bazel_dep(name = "platforms", version = "1.1.0")

# S-CORE process rules
bazel_dep(name = "score_bazel_platforms", version = "1.3.0")
bazel_dep(name = "score_docs_as_code", version = "8.6.0")
bazel_dep(name = "score_tooling", version = "3.0.2")

# LLVM source-based coverage pipeline (C++ + Rust): the qualified S-CORE
# coverage tool, successor of @score_tooling//coverage. See quality/coverage/.
bazel_dep(name = "score_coverage", version = "0.4.2", dev_dependency = True)

# Runs cc_test targets in QEMU on QNX (--run_under for on-target coverage).
bazel_dep(name = "score_qnx_unit_tests", version = "0.3.0", dev_dependency = True)

bazel_dep(name = "score_rust_policies", version = "0.0.5")
bazel_dep(name = "score_process_description", version = "2.2.2")
bazel_dep(name = "score_platform", version = "0.7.2")

bazel_dep(name = "score_itf", version = "0.7.0", dev_dependency = True)

# OCI / Docker image rules for integration tests
bazel_dep(name = "rules_oci", version = "2.2.7", dev_dependency = True)

bazel_dep(name = "rules_pkg", version = "1.2.0")

# QNX image filesystem rules for QNX integration tests
bazel_dep(name = "score_rules_imagefs", version = "0.1.0", dev_dependency = True)

imagefs = use_extension("@score_rules_imagefs//extensions:imagefs.bzl", "imagefs", dev_dependency = True)
imagefs.toolchain(
    name = "score_qnx_x86_64_ifs_toolchain",
    sdp_to_import = "@score_qcc_x86_64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    type = "ifs",
)
imagefs.toolchain(
    name = "score_qnx_aarch64_ifs_toolchain",
    sdp_to_import = "@score_qcc_aarch64_toolchain_pkg",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    type = "ifs",
)
use_repo(
    imagefs,
    "score_qnx_aarch64_ifs_toolchain",
    "score_qnx_x86_64_ifs_toolchain",
)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "ubuntu_24_04",
    digest = "sha256:2e863c44b718727c860746568e1d54afd13b2fa71b160f5cd9058fc436217b30",
    image = "ubuntu",
    platforms = ["linux/amd64"],
    tag = "24.04",
)
use_repo(oci, "ubuntu_24_04", "ubuntu_24_04_linux_amd64")

# Toolchains and extensions
bazel_dep(name = "score_bazel_cpp_toolchains", version = "1.0.5", dev_dependency = True)
bazel_dep(name = "score_toolchains_rust", version = "0.10.0", dev_dependency = True)

# S-CORE crates
bazel_dep(name = "score_crates", version = "0.0.13")

# TRLC dependency for requirements traceability
bazel_dep(name = "trlc", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "trlc",
    commit = "720dcf6704f574f81050a42f62d560165e2a1b01",  # trlc-3.1.1 (score_tooling 3.0.2 needs trlc 3.1.1)
    remote = "https://github.com/bmw-software-engineering/trlc.git",
)

gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc", dev_dependency = True)
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain",
    sdp_version = "8.0.0",
    target_cpu = "aarch64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_gcc_aarch64_toolchain",
    target_cpu = "aarch64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_gcc_x86_64_toolchain",
    target_cpu = "x86_64",
    target_os = "linux",
    use_default_package = True,
    version = "12.2.0",
)
gcc.toolchain(
    name = "score_qcc_x86_64_toolchain",
    sdp_version = "8.0.0",
    target_cpu = "x86_64",
    target_os = "qnx",
    use_default_package = True,
    version = "12.2.0",
)
use_repo(
    gcc,
    "score_gcc_aarch64_toolchain",
    "score_gcc_x86_64_toolchain",
    "score_qcc_aarch64_toolchain",
    "score_qcc_aarch64_toolchain_pkg",
    "score_qcc_x86_64_toolchain",
    "score_qcc_x86_64_toolchain_pkg",
)

llvm = use_extension(
    "@toolchains_llvm//toolchain/extensions:llvm.bzl",
    "llvm",
    dev_dependency = True,
)
llvm.toolchain(
    llvm_version = "19.1.7",
)

# Coverage-only Clang instance (covmap instrumentation for the LLVM coverage
# pipeline from @score_coverage; active only under --config=llvm_cov).
# Separate from the 19.1.7 instance above so clang-tidy behavior is untouched.
llvm.toolchain(
    name = "llvm_toolchain_coverage",
    cxx_standard = {"": "c++17"},
    extra_known_features = [
        "@score_coverage//:enable_llvm_coverage_for_death_tests",
    ],
    link_libs = {"": [
        "-lrt",
        "-latomic",
    ]},
    llvm_version = "22.1.7",
    stdlib = {"": "stdc++"},
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_coverage", "llvm_toolchain_coverage_llvm", "llvm_toolchain_llvm")

# Needed for @codeql_bundle and @codeql_coding_standards
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
codeql_release_pack = use_repo_rule(
    "//externals/codeql:codeql_release_pack.bzl",
    "codeql_release_pack",
)

PYTHON_VERSION = "3.12"

python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    is_default = True,
    python_version = PYTHON_VERSION,
)

# CodeQL Python dependencies
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip.parse(
    hub_name = "codeql_coding_standards_pip_hub",
    python_version = PYTHON_VERSION,
    requirements_lock = "//externals/codeql:requirements_lock.txt",
)
use_repo(pip, "codeql_coding_standards_pip_hub")

# C++ dependencies

bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "rapidjson", version = "1.1.0.bcr.20241007")
bazel_dep(name = "score_baselibs", version = "0.2.17")
bazel_dep(name = "score_communication", version = "0.5.0")

single_version_override(
    module_name = "score_baselibs",
    patch_strip = 1,
    patches = [
        # Export the AoU requirements file so downstream repos can consume it directly.
        "//third_party/score_baselibs:0001-logging-export-aou-requirements.patch",
    ],
)

# Rust dependencies

# Due to incoming transitive deps from baselibs flatbuffers module.
# FIXME: To be removed after https://github.com/eclipse-score/baselibs/issues/266 is resolved
single_version_override(
    module_name = "grpc-java",
    version = "1.70.0",
)

# CodeQL static analysis repositories
# The version of this tool needs to be deduced from the compatible version of the
# codeql_coding_standards release.
http_archive(
    name = "codeql_bundle",
    build_file = "//externals/codeql:codeql.BUILD",
    sha256 = "a94f674bb3c23ea5e9a2ad06b64847dd0277b15014d2517ecd9c41c88e6caa65",
    url = "https://github.com/github/codeql-action/releases/download/codeql-bundle-v2.21.4/codeql-bundle-linux64.tar.gz",
)

http_archive(
    name = "codeql_coding_standards",
    build_file = "//externals/codeql:codeql_coding_standards.BUILD",
    patch_args = ["-p1"],
    patches = ["//externals/codeql:codeql_coding_standards_misra.patch"],
    sha256 = "2aa4f4c3efd87eb24fe33bbef7f982b616a6653ae4f2a67ece268ef50cdd1ff3",
    strip_prefix = "codeql-coding-standards-{version}".format(version = CODEQL_STANDARDS_VERSION),
    urls = ["https://github.com/github/codeql-coding-standards/archive/refs/tags/v{version}.tar.gz".format(version = CODEQL_STANDARDS_VERSION)],
)

codeql_release_pack(
    name = "codeql_coding_standards_compiled",
    pack_tarball = "misra-cpp-coding-standards.tgz",
    sha256 = "775e34cb36e522c30f3c4381c0758a7fbe29e6c9a5428eb6c9ad67ebd145cb0b",
    urls = ["https://github.com/github/codeql-coding-standards/releases/download/v{version}/coding-standards-codeql-packs.zip".format(version = CODEQL_STANDARDS_VERSION)],
)

# CERT C++ and CERT C pre-compiled query packs.
codeql_release_pack(
    name = "codeql_coding_standards_cert_cpp_compiled",
    pack_tarball = "cert-cpp-coding-standards.tgz",
    sha256 = "775e34cb36e522c30f3c4381c0758a7fbe29e6c9a5428eb6c9ad67ebd145cb0b",
    urls = ["https://github.com/github/codeql-coding-standards/releases/download/v{version}/coding-standards-codeql-packs.zip".format(version = CODEQL_STANDARDS_VERSION)],
)

codeql_release_pack(
    name = "codeql_coding_standards_cert_c_compiled",
    pack_tarball = "cert-c-coding-standards.tgz",
    sha256 = "775e34cb36e522c30f3c4381c0758a7fbe29e6c9a5428eb6c9ad67ebd145cb0b",
    urls = ["https://github.com/github/codeql-coding-standards/releases/download/v{version}/coding-standards-codeql-packs.zip".format(version = CODEQL_STANDARDS_VERSION)],
)

# Self-contained (single-file .NET publish) Linux x64 build of the official
# Microsoft SARIF SDK's Sarif.Multitool
http_archive(
    name = "sarif_multitool",
    build_file = "//externals/sarif:sarif_multitool.BUILD",
    patch_cmds = ["chmod +x Sarif.Multitool"],
    sha256 = "019fe2535318b1954579bea1dac391b652e90e24dea11082625abd9a25d3816d",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/@microsoft/sarif-multitool-linux/-/sarif-multitool-linux-5.6.0.tgz",
)
