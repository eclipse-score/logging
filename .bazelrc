common --registry=https://raw.githubusercontent.com/eclipse-score/bazel_registry/main/
common --registry=https://bcr.bazel.build

# rules_android is pulled in transitively (lobster -> rules_jvm_external ->
# rules_android since score_tooling 2.x). Its android_sdk_repository extension
# fails on machines without Android SDK APIs (incl. GitHub runners). This
# project does not use Android; unset ANDROID_HOME so the lookup is skipped.
common --repo_env=ANDROID_HOME=

# Retry HTTP downloads to handle transient failures (e.g. QNX toolchain)
common --http_connector_attempts=10
common --http_connector_retry_max_timeout=1s
common --http_timeout_scaling=2.0

test --test_tag_filters=-manual
test --test_output=errors
build --incompatible_strict_action_env
build --experimental_retain_test_configuration_across_testonly #https://github.com/bazelbuild/bazel/issues/6842

# libclang toolchain required by rules_score's unit()/component() C++ parser
common --extra_toolchains=//bazel/toolchains:score_logging_libclang_toolchain

# Ferrocene must be common compiler for HOST. To ensure metadata compatibility for proc macro crates!
# Exec Rust tools (e.g. score_tooling puml_cli) also need rustc 1.88+ (psm -> ar_archive_writer,
# edition 2024); the default rules_rust toolchain (1.86) cannot compile them.
build --extra_toolchains=@score_toolchains_rust//toolchains/ferrocene:ferrocene_x86_64_unknown_linux_gnu

build:_common --features=minimal_warnings --features=-strict_warnings --features=warnings_as_errors

# Common flags for all builds
common --@score_communication//score/memory/shared/flags:use_typedshmd=False
common --//score/datarouter/build_configuration_flags:enable_dynamic_configuration=False
common --//score/datarouter/build_configuration_flags:file_transfer=False
common --//score/datarouter/build_configuration_flags:use_local_vlan=True

# TODO: Remove once score_baselibs fixes deprecated StringLiteral and
# ignored-attributes warnings (string_comparison_adaptor.h, text_format.h, etc.)
build --copt=-Wno-deprecated-declarations
build --copt=-Wno-ignored-attributes
# TODO: Remove once score_itf fixes strict-warning incompatibilities in dlt_daemon C code
build --per_file_copt=external.*score_itf.*dlt_daemon.*@-Wno-missing-prototypes,-Wno-address,-Wno-stringop-truncation,-Wno-format,-Wno-format-nonliteral,-Wno-suggest-attribute=format,-Wno-discarded-qualifiers,-Wno-undef

# Base QNX config (shared flags)
common:qnx --credential_helper=*.qnx.com=%workspace%/scripts/internal/qnx_creds.py
common:qnx --credential_helper_timeout="60s"
common:qnx --sandbox_writable_path=/var/tmp

# Warning exceptions for targets using the existing _score_common configuration.
build:_score_common --cxxopt=-Wno-error=mismatched-new-delete

# Import central S-CORE toolchain configuration
import %workspace%/score.bazelrc/score_toolchain.bazelrc

# Repository-specific warning and feature flags
build:score-linux-x86_64 --config=_common
build:score-linux-aarch64 --config=_common
build:score-qnx-x86_64 --config=_common
build:score-qnx-aarch64 --config=_common

# Python precompile disabling for GCC toolchains
build:score-linux-x86_64 --@rules_python//python/config_settings:precompile=force_disabled
build:score-linux-aarch64 --@rules_python//python/config_settings:precompile=force_disabled

# Target specific settings for QNX
build:score-qnx-x86_64 --config=qnx
build:score-qnx-aarch64 --config=qnx
test:score-qnx-x86_64 --strategy=TestRunner=local
test:score-qnx-x86_64 --local_test_jobs=1

# -------------------------------------------------------------------------------
# Backward-compatibility aliases for previous config names
# -------------------------------------------------------------------------------
build:x86_64-linux --config=score-linux-x86_64
build:aarch64-linux --config=score-linux-aarch64
build:x86_64-qnx --config=score-qnx-x86_64
build:arm64-qnx --config=score-qnx-aarch64

# Select the same Linux GCC toolchain as the other host test configurations.
build:asan --config=x86_64-linux
build:ubsan --config=x86_64-linux
build:lsan --config=x86_64-linux
build:tsan --config=x86_64-linux

# Exclude tests tagged as incompatible with each sanitizer.
test:asan --test_tag_filters=-no-asan
test:ubsan --test_tag_filters=-no-ubsan
test:lsan --test_tag_filters=-no-lsan
test:asan_ubsan_lsan --test_tag_filters=-no-asan,-no-lsan,-no-ubsan
test:tsan --test_tag_filters=-no-tsan
test:tsan_ubsan --test_tag_filters=-no-tsan,-no-ubsan

# GCC 12 warns that TSan does not instrument atomic_thread_fence in dependencies such as baselibs.
build:tsan --cxxopt=-Wno-error=tsan
test:tsan --cxxopt=-O1

# Clang-tidy: bazel test --config=clang-tidy //score/...
test:clang-tidy --aspects=//tools/lint:linters.bzl%clang_tidy_aspect
test:clang-tidy --output_groups=+rules_lint_report
test:clang-tidy --extra_toolchains=@llvm_toolchain//:cc-toolchain-x86_64-linux
# toolchains_llvm >= 1.8.0 emits -stdlib=libc++ together with -nostdinc++ (explicit
# libc++ include paths); clang then reports -stdlib as unused, which the
# warnings_as_errors feature turns into an error. Analysis is unaffected.
test:clang-tidy --copt=-Wno-unused-command-line-argument
# The libclang toolchain (bazel/toolchains) pulls some targets (e.g.
# backend_mock) into the exec/tool configuration, where --copt does not apply;
# mirror the warning suppression there via --host_copt.
test:clang-tidy --host_copt=-Wno-unused-command-line-argument

# Banned-function check: bazel build --config=banned-functions //score/mw/log/...
build:banned-functions --aspects=//tools/lint:linters.bzl%banned_functions_aspect
build:banned-functions --output_groups=rules_lint_human
build:banned-functions --@aspect_rules_lint//lint:fail_on_violation
build:banned-functions --extra_toolchains=@llvm_toolchain_coverage//:cc-toolchain-x86_64-linux
build:banned-functions --copt=-Wno-unused-command-line-argument
build:banned-functions --host_copt=-Wno-unused-command-line-argument

# Unified LLVM source-based coverage (C++ + Rust), see quality/coverage/ and
# @score_coverage. Use: bazel coverage --config=llvm_cov //score/... --build_tests_only
import %workspace%/quality/coverage/coverage.bazelrc

# CodeQL / MISRA static analysis configuration. See //quality/static_analysis.
import %workspace%/quality/static_analysis/static_analysis.bazelrc
